{
  "name": "fps-kill",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "FPS-themed card battle game (engine-first MVP)",
  "engines": {
    "node": ">=22.15"
  },
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "typecheck": "tsc -p . && pnpm -C apps/web typecheck && pnpm -C apps/server typecheck",
    "test": "node --test \"packages/engine/test/*.test.ts\" \"apps/server/test/*.test.ts\"",
    "verify": "pnpm typecheck && pnpm test",
    "demo": "node scripts/battle.ts",
    "server": "node apps/server/src/main.ts",
    "web:dev": "pnpm -C apps/web dev",
    "web:build": "pnpm -C apps/web build",
    "web:preview": "pnpm -C apps/web preview"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
